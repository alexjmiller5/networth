{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "networth",
	"compatibility_date": "2026-07-06",
	// The hub is another Worker: route fetch through its public URL rather
	// than Cloudflare's same-zone origin path, which does not invoke it.
	"compatibility_flags": ["nodejs_als", "global_fetch_strictly_public"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	"secrets": { "required": ["LIFE_HUB_TOKEN"] },
	// Where the estate lives. The read token (LIFE_HUB_TOKEN) is a Worker
	// secret pushed by scripts/sync-secrets.sh, never a var.
	"vars": {
		"LIFE_HUB_URL": "https://life-data.nqipomyrjb.workers.dev"
	}
}
