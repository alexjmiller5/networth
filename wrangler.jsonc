{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "networth",
	"compatibility_date": "2026-07-06",
	// The hub is another Worker: route fetch through its public URL rather
	// than Cloudflare's same-zone origin path, which does not invoke it.
	"compatibility_flags": ["nodejs_als", "global_fetch_strictly_public"],
	// worker.js wraps the SvelteKit Worker (svelte.wrangler.jsonc) with the cron handler.
	"main": "worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	// Networth owns this database. Local Wrangler uses isolated on-disk D1 state.
	"d1_databases": [
		{
			// Enrolled finance hosts. The database keeps its original name.
			"binding": "HOSTS_DB",
			"database_name": "networth-widgets",
			"database_id": "b3b28b4b-bd99-4654-9974-665d7e1c948c",
			"migrations_dir": "migrations-hosts"
		},
		{
			"binding": "MARKERS_DB",
			"database_name": "networth-markers",
			"database_id": "da87045c-3f3a-4663-a3fb-eedf28c856b4",
			"migrations_dir": "migrations"
		},
		{
			"binding": "FINANCE_RUNS_DB",
			"database_name": "networth-finance-runs",
			"database_id": "c6d75a4c-4bc1-4cab-94e9-08fc62cbe126",
			"migrations_dir": "migrations-finance-runs"
		},
		{
			"binding": "PRICES_DB",
			"database_name": "networth-prices",
			"database_id": "0ae6d643-097f-452b-a104-1870bafe2e9e",
			"migrations_dir": "migrations-prices"
		},
		{
			// Disposable copy of the Soma tables Networth reads, with their pull cursors.
			"binding": "ESTATE_CACHE_DB",
			"database_name": "networth-estate-cache",
			"database_id": "dbfbd287-e2b7-433b-b558-68921f3e0f97",
			"migrations_dir": "migrations-estate-cache"
		}
	],
	// Daily price cache refresh (worker.js `scheduled`), after US mutual fund NAVs post.
	"triggers": { "crons": ["30 2 * * *"] },
	"secrets": { "required": ["SOMA_HUB_TOKEN", "TIINGO_API_KEY"] },
	// Where the estate lives. The read token (SOMA_HUB_TOKEN) is a Worker
	// secret pushed by scripts/sync-secrets.sh, never a var.
	"vars": {
		"SOMA_HUB_URL": "https://soma.nqipomyrjb.workers.dev"
	}
}
